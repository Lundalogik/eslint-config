{
  "name": "@limetech/eslint-config",
  "version": "4.1.0",
  "description": "Reusable lint rules for use in other packages.",
  "author": "Lime Technologies",
  "license": "Apache-2.0",
  "main": "eslint.config.js",
  "module": "eslint.config.js",
  "type": "module",
  "files": [
    "eslint.config.js",
    "prettier.config.js"
  ],
  "exports": {
    ".": {
      "import": "./eslint.config.js",
      "default": "./eslint.config.js"
    },
    "./prettier.config.js": {
      "import": "./prettier.config.js",
      "default": "./prettier.config.js"
    }
  },
  "scripts": {
    "check:peer-range": "node scripts/check-typescript-peer-range.mjs",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix --max-warnings=0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lundalogik/eslint-config.git"
  },
  "keywords": [
    "Lime",
    "lint",
    "linting",
    "linter",
    "rules",
    "eslint",
    "eslintconfig",
    "prettier"
  ],
  "bugs": {
    "url": "https://github.com/Lundalogik/eslint-config/issues"
  },
  "homepage": "https://github.com/Lundalogik/eslint-config#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": ">= 9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ban": "^2.0.0",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.1"
  },
  "devDependencies": {
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependencies": {
    "eslint": ">= 9",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
